# Copia este archivo a .env y completa los valores reales.
# .env NO se sube a GitHub (ver .gitignore).

# Secreto para firmar los tokens JWT (genera uno con: openssl rand -hex 32)
JWT_SECRET=cambia-este-secreto

# Contraseña del certificado HTTPS (server/cert.pfx). Si no existe, el server
# solo levanta HTTP.
CERT_PASSPHRASE=cambia-esta-passphrase
